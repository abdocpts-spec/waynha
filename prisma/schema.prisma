// WAYNHA | وينها - قاعدة بيانات الإجراءات والجهات الحكومية
// كل النصوص مخزنة بالعربية والإنجليزية (حقول Ar / En).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id
  icon      String
  color     String
  titleAr   String
  titleEn   String
  sortOrder Int      @default(0)
  /// مدة المراجعة الافتراضية لخدمات هذا القسم بالأيام (يحدّدها الأدمن)
  reviewIntervalDays Int @default(180)

  services Service[]
  offices  OfficeCategory[]

  @@map("categories")
}

model City {
  id     String   @id
  nameAr String
  nameEn String
  offices Office[]

  @@map("cities")
}

model Service {
  id         String   @id
  categoryId String
  icon       String   @default("📄")
  popular    Boolean  @default(false)
  verified   Boolean  @default(false)
  /// بيانات تجريبية للعرض فقط — تُعرض للمستخدم مع تنبيه واضح
  isDemo     Boolean  @default(true)

  titleAr       String
  titleEn       String
  shortDescAr   String
  shortDescEn   String
  departmentAr  String
  departmentEn  String
  feesAr        String
  feesEn        String
  durationAr    String
  durationEn    String
  hoursAr       String
  hoursEn       String
  eligibilityAr String
  eligibilityEn String
  sourceAr      String
  sourceEn      String

  lastReviewedAt DateTime?
  /// موعد المراجعة القادمة (إن لم يُحدَّد يُحسب من مدة المراجعة)
  nextReviewAt DateTime?
  /// مدة مراجعة خاصة بهذه الخدمة (تتقدم على مدة القسم)
  reviewIntervalDays Int?
  /// المراجع الذي سجّل آخر مراجعة فعلية (بدونه لا تُعرض الخدمة كمراجَعة)
  reviewedById Int?
  /// آخر تعديل لمحتوى الخدمة؛ إن جاء بعد المراجعة تحتاج مراجعة جديدة
  contentEditedAt DateTime?

  /// لمن هذه الخدمة: الكل، المواطن، أو الأجنبي
  audience Audience      @default(ALL)
  /// مرحلة اعتماد المعلومة (يديرها الأدمن): الزوار يرون PUBLISHED و NEEDS_UPDATE فقط
  status   ContentStatus @default(PUBLISHED)
  /// ملاحظة الأدمن عند المراجعة (داخلية)
  reviewNote String?

  /// نص البحث بعد التطبيع (عربي + إنجليزي) — يُستخدم في بحث SQL
  searchText String

  // للتوسعة لاحقاً: عمود embedding vector(1536) عبر pgvector للبحث الدلالي.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  steps       ServiceStep[]
  documents   ServiceDocument[]
  notes       ServiceNote[]
  faqs        ServiceFaq[]
  keywords    ServiceKeyword[]
  relatedTo   ServiceRelation[]  @relation("RelationFrom")
  relatedFrom ServiceRelation[]  @relation("RelationTo")
  reports     Report[]
  progress    ProcedureProgress[]
  offices     OfficeService[]
  sources     ServiceSource[]
  reviewedBy  User?              @relation("ServiceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([popular])
  @@index([status])
  @@map("services")
}

/// مصدر معلومة الخدمة. وجود رابط وحده لا يكفي دليلاً على صحة المعلومة
model ServiceSource {
  id         Int        @id @default(autoincrement())
  serviceId  String
  name       String
  nameEn     String?
  type       SourceType @default(OTHER)
  url        String?
  /// تاريخ اطلاع فريق وينها على المصدر
  accessedAt DateTime?
  note       String?
  linkStatus    LinkStatus @default(UNCHECKED)
  linkCheckedAt DateTime?
  createdAt  DateTime   @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_sources")
}

enum SourceType {
  OFFICIAL_WEBSITE
  OFFICIAL_DOCUMENT
  OFFICE_VISIT
  PHONE_CALL
  ANNOUNCEMENT
  OTHER
}

enum LinkStatus {
  UNCHECKED
  OK
  BROKEN
}

/// سجل مراجعات الخدمة وتعديلاتها (للأدمن فقط). لا يُحذف بحذف المستخدم
model ServiceAudit {
  id          Int      @id @default(autoincrement())
  serviceId   String
  userId      Int?
  userName    String
  /// CREATED | EDITED | REVIEWED | STATUS | SOURCE_ADDED | SOURCE_EDITED | SOURCE_REMOVED | SCHEDULE
  action      String
  /// الحقول التي تغيّرت أو تفاصيل الإجراء
  changes     Json     @default("{}")
  sourceName  String?
  note        String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([serviceId, createdAt])
  @@map("service_audits")
}

model ServiceStep {
  id        Int    @id @default(autoincrement())
  serviceId String
  position  Int
  textAr    String
  textEn    String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_steps")
}

model ServiceDocument {
  id        Int    @id @default(autoincrement())
  serviceId String
  position  Int
  textAr    String
  textEn    String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_documents")
}

model ServiceNote {
  id        Int    @id @default(autoincrement())
  serviceId String
  position  Int
  textAr    String
  textEn    String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_notes")
}

model ServiceFaq {
  id         Int    @id @default(autoincrement())
  serviceId  String
  position   Int
  questionAr String
  questionEn String
  answerAr   String
  answerEn   String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_faqs")
}

/// كلمات البحث بما فيها اللهجة الليبية ("ضيعت جوازي"، "نطلع ورقة ميلاد")
model ServiceKeyword {
  id        Int    @id @default(autoincrement())
  serviceId String
  /// الكلمة بعد التطبيع (بدون تشكيل، أ/إ/آ → ا، ة → ه)
  keyword   String
  weight    Int    @default(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, keyword])
  @@index([keyword])
  @@map("service_keywords")
}

model ServiceRelation {
  fromId String
  toId   String

  from Service @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Service @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@map("service_relations")
}

model Office {
  id           Int     @id @default(autoincrement())
  nameAr       String
  nameEn       String
  departmentAr String
  departmentEn String
  cityId       String
  addressAr    String
  addressEn    String
  phone        String
  lat          Float
  lng          Float
  /// مغلق مؤقتاً بقرار إداري (تُحسب حالة "مفتوح الآن" من أوقات الدوام)
  temporarilyClosed Boolean @default(false)
  /// أيام الدوام: 0 = الأحد ... 6 = السبت
  openDays     Int[]
  openTime     String
  closeTime    String
  /// بيانات تجريبية للعرض فقط
  isDemo       Boolean @default(true)
  /// رابط الموقع على Google Maps إن وُجد (اختياري، يدخله الأدمن)
  mapsUrl      String?
  /// تعطيل الموقع بدل حذفه (لا يظهر للزوار)
  active       Boolean @default(true)
  /// مرحلة النشر: الزوار يرون PUBLISHED فقط (المسودة تُراجع قبل النشر)
  status       ContentStatus @default(PUBLISHED)

  searchText String @default("")

  city       City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  categories OfficeCategory[]
  services   OfficeService[]
  reports    Report[]

  @@index([cityId])
  @@map("offices")
}

model OfficeCategory {
  officeId   Int
  categoryId String

  office   Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([officeId, categoryId])
  @@map("office_categories")
}

/// الخدمات التي تقدمها الجهة (الخريطة تعرض للخدمة الجهات المرتبطة بها فقط)
model OfficeService {
  officeId  Int
  serviceId String

  office  Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([officeId, serviceId])
  @@index([serviceId])
  @@map("office_services")
}

// ─────────── المستخدمون والجلسات والبلاغات ───────────

enum Role {
  CITIZEN
  FOREIGNER
  ADMIN
}

enum Audience {
  ALL
  CITIZEN
  FOREIGNER
}

/// مراحل اعتماد المعلومة (وينها لا تعتمد معاملات المواطن؛ تعتمد صحة المعلومة فقط)
enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  NEEDS_UPDATE
}

enum ReportKind {
  PHONE
  LOCATION
  OUTDATED
  MISSING
  OTHER
  DOCUMENTS
  STEPS
  FEES
  HOURS
  SOURCE_LINK
}

enum ReportStatus {
  NEW
  IN_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  /// بريد إلكتروني أو رقم هاتف (بعد التطبيع: حروف صغيرة بدون مسافات)
  login        String   @unique
  /// بريد إلكتروني اختياري مستقل (حقل منفصل عن الهاتف)
  email        String?  @unique
  /// للمواطن فقط: بصمة HMAC-SHA256 للرقم الوطني (لا يُخزَّن الرقم نفسه ولا يمكن استرجاعه)
  nationalIdHash String? @unique
  /// للأجنبي: بصمة HMAC-SHA256 لرقم الإقامة (اختياري لمن لم يحصل على إقامة بعد)
  residenceIdHash String? @unique
  name         String
  role         Role     @default(CITIZEN)
  /// scrypt: salt:hash (لا تُخزَّن كلمة المرور نفسها أبداً)
  passwordHash String
  cityId       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  sessions Session[]
  reports  Report[]
  progress ProcedureProgress[]
  reviewedServices Service[] @relation("ServiceReviewer")
  audits   ServiceAudit[]

  @@map("users")
}

model Session {
  /// SHA-256 لرمز الجلسة؛ الرمز نفسه في كوكي httpOnly فقط
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// بلاغ عن معلومة غير صحيحة يرسله أي زائر أو مستخدم
model Report {
  id         Int          @id @default(autoincrement())
  serviceId  String?
  officeId   Int?
  kind       ReportKind
  message    String
  status     ReportStatus @default(NEW)
  adminNote  String?
  userId     Int?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  office  Office?  @relation(fields: [officeId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("reports")
}

/// ترجمات آلية مخزّنة لنصوص الواجهة (المفتاح: اللغة + بصمة النص الأصلي)
model Translation {
  lang      String
  hash      String
  source    String
  text      String
  createdAt DateTime @default(now())

  @@id([lang, hash])
  @@map("translations")
}

/// متابعة المستخدم لإجراء: المرحلة يحدّدها بنفسه وليست حالة رسمية من أي جهة
model ProcedureProgress {
  id         Int       @id @default(autoincrement())
  userId     Int
  serviceId  String
  /// المرحلة الحالية من 1 إلى 5 (انظر lib/progress/stages.ts)
  stage      Int       @default(1)
  /// مراجعة فريق وينها لمستندات مرحلة «أجمع المستندات» (ليست قبولاً رسمياً من الجهة)
  reviewStatus ReviewStatus @default(NONE)
  /// ملاحظة الأدمن عند طلب التعديل
  reviewNote   String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  /// تاريخ بلوغ كل مرحلة (ISO) بمفتاح رقم المرحلة
  stageDates Json      @default("{}")
  reminderAt DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  files   ProcedureFile[]

  @@unique([userId, serviceId])
  @@map("procedure_progress")
}

enum ReviewStatus {
  NONE
  PENDING
  NEEDS_CHANGES
  APPROVED
}

/// ملف مستند رفعه الزبون. المحتوى على القرص خارج public (lib/progress/files.ts) والاسم عشوائي
model ProcedureFile {
  id         Int      @id @default(autoincrement())
  progressId Int
  /// الاسم الأصلي للعرض فقط
  name       String
  storedName String   @unique
  mime       String
  size       Int
  createdAt  DateTime @default(now())

  progress ProcedureProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId])
  @@map("procedure_files")
}
