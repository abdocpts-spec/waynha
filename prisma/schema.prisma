// WAYNHA | وينها - قاعدة بيانات الإجراءات والجهات الحكومية
// كل النصوص مخزنة بالعربية والإنجليزية (حقول Ar / En).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id
  icon      String
  color     String
  titleAr   String
  titleEn   String
  sortOrder Int      @default(0)

  services Service[]
  offices  OfficeCategory[]

  @@map("categories")
}

model City {
  id     String   @id
  nameAr String
  nameEn String
  offices Office[]

  @@map("cities")
}

model Service {
  id         String   @id
  categoryId String
  icon       String   @default("📄")
  popular    Boolean  @default(false)
  verified   Boolean  @default(false)
  /// بيانات تجريبية للعرض فقط — تُعرض للمستخدم مع تنبيه واضح
  isDemo     Boolean  @default(true)

  titleAr       String
  titleEn       String
  shortDescAr   String
  shortDescEn   String
  departmentAr  String
  departmentEn  String
  feesAr        String
  feesEn        String
  durationAr    String
  durationEn    String
  hoursAr       String
  hoursEn       String
  eligibilityAr String
  eligibilityEn String
  sourceAr      String
  sourceEn      String

  lastReviewedAt DateTime?

  /// لمن هذه الخدمة: الكل، المواطن، أو الأجنبي
  audience Audience      @default(ALL)
  /// مرحلة اعتماد المعلومة (يديرها الأدمن): الزوار يرون PUBLISHED و NEEDS_UPDATE فقط
  status   ContentStatus @default(PUBLISHED)
  /// ملاحظة الأدمن عند المراجعة (داخلية)
  reviewNote String?

  /// نص البحث بعد التطبيع (عربي + إنجليزي) — يُستخدم في بحث SQL
  searchText String

  // للتوسعة لاحقاً: عمود embedding vector(1536) عبر pgvector للبحث الدلالي.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  steps       ServiceStep[]
  documents   ServiceDocument[]
  notes       ServiceNote[]
  faqs        ServiceFaq[]
  keywords    ServiceKeyword[]
  relatedTo   ServiceRelation[]  @relation("RelationFrom")
  relatedFrom ServiceRelation[]  @relation("RelationTo")
  reports     Report[]

  @@index([categoryId])
  @@index([popular])
  @@index([status])
  @@map("services")
}

model ServiceStep {
  id        Int    @id @default(autoincrement())
  serviceId String
  position  Int
  textAr    String
  textEn    String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_steps")
}

model ServiceDocument {
  id        Int    @id @default(autoincrement())
  serviceId String
  position  Int
  textAr    String
  textEn    String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_documents")
}

model ServiceNote {
  id        Int    @id @default(autoincrement())
  serviceId String
  position  Int
  textAr    String
  textEn    String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_notes")
}

model ServiceFaq {
  id         Int    @id @default(autoincrement())
  serviceId  String
  position   Int
  questionAr String
  questionEn String
  answerAr   String
  answerEn   String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_faqs")
}

/// كلمات البحث بما فيها اللهجة الليبية ("ضيعت جوازي"، "نطلع ورقة ميلاد")
model ServiceKeyword {
  id        Int    @id @default(autoincrement())
  serviceId String
  /// الكلمة بعد التطبيع (بدون تشكيل، أ/إ/آ → ا، ة → ه)
  keyword   String
  weight    Int    @default(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, keyword])
  @@index([keyword])
  @@map("service_keywords")
}

model ServiceRelation {
  fromId String
  toId   String

  from Service @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Service @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@map("service_relations")
}

model Office {
  id           Int     @id @default(autoincrement())
  nameAr       String
  nameEn       String
  departmentAr String
  departmentEn String
  cityId       String
  addressAr    String
  addressEn    String
  phone        String
  lat          Float
  lng          Float
  /// مغلق مؤقتاً بقرار إداري (تُحسب حالة "مفتوح الآن" من أوقات الدوام)
  temporarilyClosed Boolean @default(false)
  /// أيام الدوام: 0 = الأحد ... 6 = السبت
  openDays     Int[]
  openTime     String
  closeTime    String
  /// بيانات تجريبية للعرض فقط
  isDemo       Boolean @default(true)

  searchText String @default("")

  city       City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  categories OfficeCategory[]
  reports    Report[]

  @@index([cityId])
  @@map("offices")
}

model OfficeCategory {
  officeId   Int
  categoryId String

  office   Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([officeId, categoryId])
  @@map("office_categories")
}

// ─────────── المستخدمون والجلسات والبلاغات ───────────

enum Role {
  CITIZEN
  FOREIGNER
  ADMIN
}

enum Audience {
  ALL
  CITIZEN
  FOREIGNER
}

/// مراحل اعتماد المعلومة (وينها لا تعتمد معاملات المواطن؛ تعتمد صحة المعلومة فقط)
enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  NEEDS_UPDATE
}

enum ReportKind {
  PHONE
  LOCATION
  OUTDATED
  MISSING
  OTHER
}

enum ReportStatus {
  NEW
  IN_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  /// بريد إلكتروني أو رقم هاتف (بعد التطبيع: حروف صغيرة بدون مسافات)
  login        String   @unique
  /// بريد إلكتروني اختياري مستقل (حقل منفصل عن الهاتف)
  email        String?  @unique
  /// للمواطن فقط: بصمة HMAC-SHA256 للرقم الوطني (لا يُخزَّن الرقم نفسه ولا يمكن استرجاعه)
  nationalIdHash String? @unique
  /// للأجنبي: بصمة HMAC-SHA256 لرقم الإقامة (اختياري لمن لم يحصل على إقامة بعد)
  residenceIdHash String? @unique
  name         String
  role         Role     @default(CITIZEN)
  /// scrypt: salt:hash (لا تُخزَّن كلمة المرور نفسها أبداً)
  passwordHash String
  cityId       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  sessions Session[]
  reports  Report[]

  @@map("users")
}

model Session {
  /// SHA-256 لرمز الجلسة؛ الرمز نفسه في كوكي httpOnly فقط
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// بلاغ عن معلومة غير صحيحة يرسله أي زائر أو مستخدم
model Report {
  id         Int          @id @default(autoincrement())
  serviceId  String?
  officeId   Int?
  kind       ReportKind
  message    String
  status     ReportStatus @default(NEW)
  adminNote  String?
  userId     Int?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  office  Office?  @relation(fields: [officeId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("reports")
}

/// ترجمات آلية مخزّنة لنصوص الواجهة (المفتاح: اللغة + بصمة النص الأصلي)
model Translation {
  lang      String
  hash      String
  source    String
  text      String
  createdAt DateTime @default(now())

  @@id([lang, hash])
  @@map("translations")
}
