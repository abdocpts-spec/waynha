# انسخ هذا الملف إلى .env.local ثم املأ القيم.
# .env.local لا يُرفع إلى git (موجود في .gitignore).

# مفتاح Gemini API — يُستعمل من الخادم فقط.
# ممنوع وضعه في أي ملف داخل app/ (خارج api) أو components/ أو أي كود يصل للمتصفح.
# احصل عليه من: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# اختياري — لتغيير النماذج المستخدمة
GEMINI_MODEL=gemini-flash-lite-latest
# بديل سريع عند ضغط 503 على النموذج الأساسي (مفصولة بفواصل)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# أقصى انتظار لأول كلمة من كل نموذج (ملي ثانية)
# GEMINI_FIRST_TOKEN_TIMEOUT_MS=12000

# قاعدة بيانات PostgreSQL
# للتطوير المحلي: شغّل "npm run db:start" واستخدم هذا الرابط كما هو
DATABASE_URL="postgresql://waynha:waynha_dev@127.0.0.1:5433/waynha"

# سر بصمة الرقم الوطني (HMAC). ولّده مرة واحدة:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# لا تغيّره بعد التشغيل، ولا ترفعه إلى git.
NATIONAL_ID_SECRET=

# مفتاح Google Maps JavaScript API لصفحة «وين نمشي؟» (اختياري).
# بدونه تعمل الخريطة بـ OpenStreetMap. المفتاح يظهر في المتصفح بطبيعته،
# فقيّده في Google Cloud بنطاق موقعك (HTTP referrers) وبواجهات Maps JavaScript و Distance Matrix فقط.
GOOGLE_MAPS_API_KEY=
